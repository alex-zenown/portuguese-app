# Server
PORT=3000
BASE_URL=https://your-deployed-url.com

# DocuSign
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_SECRET_KEY=your_secret_key
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_PRIVATE_KEY_PATH=./docusign_private_key.pem
DOCUSIGN_TEMPLATE_ID=your_loe_template_id
# Set to https://account-d.docusign.com for sandbox, https://account.docusign.com for production
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
YOUR_WHATSAPP_NUMBER=whatsapp:+447XXXXXXXXX

# Calendly
CALENDLY_API_TOKEN=your_calendly_api_token

# Follow-up settings (hours)
FOLLOWUP_FIRST_REMINDER_HOURS=48
FOLLOWUP_SECOND_REMINDER_HOURS=120
FOLLOWUP_ESCALATE_HOURS=168

# Dashboard auth (basic)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
